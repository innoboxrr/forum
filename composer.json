{
    "name": "innoboxrr/forum",
    "license": "MIT",
    "type": "library",
    "description": "A simple forum package for your laravel app",
    "authors": [
        {
            "name": "Homero Raul",
            "email": "homero.vargas@innoboxrr.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "mews/purifier": "^3.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.5",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "orchestra/testbench": "^11.0",
        "innoboxrr/larapack-generator": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Innoboxrr\\Forum\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\Forum\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\Forum\\ForumServiceProvider"
            ]
        }
    }
}
